DOCKERHUB_NAMESPACE=your-dockerhub-username
IMAGE_TAG=0.1.0
COMPOSE_PROJECT_NAME=devops-course
NGINX_PORT=8080
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password
UID=1000
GID=1000

# --- Приложение (необязательно, значения по умолчанию заданы в compose.yaml) ---
# Окружение - одно из описанных в app/config/params.php: local | staging | production
APP_ENV=local
# Ключ шифрования значений конфига (enc:v1:...)
#   docker compose exec php php bin/config key:generate
# потом вписать сюда строку вида base64:.... Пустой ключ допустим, пока в params.php нет зашифрованных значений.
APP_CONFIG_KEY=
APP_DEBUG=true
LOG_LEVEL=debug
LOG_MAX_FILES=14
LOG_QUERIES=true
LOG_BODY_MAX_BYTES=10240
